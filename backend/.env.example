# Generate with: openssl rand -hex 32   (at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-string

# Any OpenAI-compatible chat API. Default: the local llama.cpp container (no key, no cost).
LLM_BASE_URL=http://localhost:8090/v1
LLM_MODEL=local
LLM_API_KEY=not-needed
# Groq free tier:   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile  LLM_API_KEY=gsk_...
# Gemini free tier: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
# Claude:           LLM_BASE_URL=https://api.anthropic.com/v1  LLM_MODEL=claude-sonnet-5-5  LLM_API_KEY=sk-ant-...

# llm | remote (fine-tuned router from routelab, set ROUTER_URL) | keywords
ROUTER_MODE=llm
# ROUTER_URL=http://localhost:8700

# ":memory:" keeps the help-center index in the process; use http://localhost:6333 for a Qdrant server.
QDRANT_URL=:memory:
SUPPORT_REFUND_LIMIT=50
VOICE_ENABLED=false
